#!/bin/sh
# Canonical local verification harness. GitHub Actions calls these same lanes;
# the repository, rather than a hosting provider, defines what "verified" means.

set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

heading() {
    printf '\n==> %s\n' "$1"
}

need_command() {
    if command -v "$1" >/dev/null 2>&1; then
        return
    fi

    cargo_bin=${CARGO_HOME:-"$HOME/.cargo"}/bin
    if [ -x "$cargo_bin/$1" ]; then
        PATH="$cargo_bin:$PATH"
        export PATH
        return
    fi

    printf 'missing required command: %s\n' "$1" >&2
    printf '%s\n' "$2" >&2
    exit 127
}

run_static() {
    heading "strict Clippy"
    cargo clippy --workspace --all-targets --locked -- -D warnings
}

run_contracts() {
    heading "two-sided invariant contract registry"
    sh scripts/check-test-contracts
}

run_test() {
    run_contracts

    heading "workspace tests (all current and future targets)"
    cargo test --workspace --all-targets --locked

    heading "kernel acceptance demo"
    cargo run --quiet --locked -p asf -- demo

    heading "broker acceptance demo"
    cargo run --quiet --locked -p asf -- broker-demo
}

run_audit() {
    need_command cargo-audit \
        "install it with: cargo install cargo-audit --locked --version 0.22.2"
    heading "RustSec dependency audit"
    cargo audit
}

run_deep() {
    ASF_PROPTEST_CASES=${ASF_PROPTEST_CASES:-4096}
    ASF_MODEL_CASES=${ASF_MODEL_CASES:-512}
    export ASF_PROPTEST_CASES ASF_MODEL_CASES

    heading "release tests (${ASF_PROPTEST_CASES} authority cases; ${ASF_MODEL_CASES} model histories)"
    cargo test --workspace --all-targets --release --locked
}

run_mutation() {
    need_command cargo-mutants \
        "install it with: cargo install cargo-mutants --locked --version 27.1.0"

    heading "W-10 SQLite runtime-floor mutation tests"
    # The dependency pin prevents the known-bad engine from being selected;
    # this stable function target guards the independent fail-before-effects
    # runtime check against comparison and return-value regressions.
    cargo mutants \
        -f crates/asf-kernel/src/kernel.rs \
        -F 'require_safe_sqlite_version' \
        -j 4 \
        --minimum-test-timeout 20 \
        --timeout-multiplier 3

    heading "W-12 strict JCS input-domain mutation tests"
    # Stable predicates for the numeric boundary, recursive traversal, and
    # duplicate-name rejection. Raw fabric-object ingresses all route through
    # the parser that consumes these predicates before constructing a Value.
    cargo mutants \
        -f crates/asf-kernel/src/canon.rs \
        -F '(w12_(number_is_in_domain|validate_value|raw_number_is_in_domain|validate_raw_numbers|duplicate_key)|parse_fabric_json)' \
        -j 4 \
        --minimum-test-timeout 20 \
        --timeout-multiplier 3

    heading "W-13 key-continuity mutation tests"
    # Stable boundaries for explicit-new-home refusal, exact required-key
    # loading, and malformed secret-store rejection. These are the predicates
    # whose absence would recreate RF-18 or overwrite protected credentials.
    cargo mutants \
        -f crates/asf-cli/src/proxy.rs \
        -f crates/asf-kernel/src/kernel.rs \
        -f crates/asf-kernel/src/keys.rs \
        -f crates/asf-kernel/src/snapshot.rs \
        -F '(w13_open_fabric_before_runtime_state|w13_validate_existing_runtime_store|w13_fabric_entry_exists|w13_runtime_store_entry_exists|w13_initialize_memory_store|w13_prepare_new_home|w13_validate_existing_fabric_home|w13_load_required_key|w13_load_secret_store|w13_parse_secret_store|w13_validate_existing_cas)' \
        -j 4 \
        --minimum-test-timeout 20 \
        --timeout-multiplier 3

    heading "authority-evaluation and promotion-policy mutation tests"
    cargo mutants \
        -f crates/asf-kernel/src/evaluate.rs \
        -f crates/asf-kernel/src/promote.rs \
        -j 4 \
        --minimum-test-timeout 20 \
        --timeout-multiplier 3

    heading "A21/M7 authority-binding mutation tests"
    # Second exclusion since W-8: the ordering guard in m7_verify_grant is
    # backstopped by the a22 leaf-activation check that runs on the same
    # gate path (defense in depth) — under honest emission the two layers
    # are equivalent (grants land only on the substrate span; both views
    # take the earliest offset), so the guard→true mutant is masked, and
    # the ordering property itself is killed in the a22 lane below.
    cargo mutants \
        -f crates/asf-kernel/src/broker.rs \
        -F 'm7_(grant_offsets|effect_capability|verify_grant)' \
        -E 'replace < with <= in m7_verify_grant' \
        -E 'replace match guard \*grant_offset < effect_offset with true in m7_verify_grant' \
        -j 4 \
        --minimum-test-timeout 20 \
        --timeout-multiplier 3

    heading "A22/§5.4 capability-closure mutation tests"
    # The closure duals of the m7_* activation predicates: the pure
    # event-derived liveness view shared by decision time and gate replay.
    # Named functions, not source lines, so refactoring cannot silently
    # move the closure predicates outside the scheduled check (G5).
    # Excluded as equivalent (the m7_verify_grant precedent): substrate
    # offsets are globally unique, so a revoke or grant and the effect it
    # is compared against can never occupy the same offset, and decision
    # time evaluates at head+1, which no existing event occupies —
    # < and <= are indistinguishable at every call site.
    cargo mutants \
        -f crates/asf-kernel/src/broker.rs \
        -F 'a22_(revoke_offsets|grant_bindings|ancestry|state_at)' \
        -E 'replace < with <= in a22_state_at' \
        -j 4 \
        --minimum-test-timeout 20 \
        --timeout-multiplier 3

    heading "RF-16 signed-event/index-boundary mutation tests"
    # A22 predicates consume VerifiedEvent only. This lane guards the caller
    # boundary that proves every materialized selector agrees with signed raw;
    # without it, predicate-only mutation evidence overclaims event derivation.
    cargo mutants \
        -f crates/asf-kernel/src/trace.rs \
        -F 'verified_event_from_row' \
        -j 4 \
        --minimum-test-timeout 20 \
        --timeout-multiplier 3

    heading "W-11 verified-event consumer mutation tests"
    # Guard the three independent-review fixes beyond construction:
    # one-statement observed head, signed-seq branch tip, and exact
    # fabric-lifetime placement for live tool registration.
    cargo mutants \
        -f crates/asf-kernel/src/trace.rs \
        -f crates/asf-kernel/src/broker.rs \
        -f crates/asf-kernel/src/tools.rs \
        -F '(w11_observed_head|w11_span_events_in_signed_sequence|w11_final_tool_call|w11_live_tool_registration)' \
        -j 4 \
        --minimum-test-timeout 20 \
        --timeout-multiplier 3
}

usage() {
    cat <<'EOF'
usage: scripts/ci <lane>

lanes:
  static    strict Clippy over the workspace and all targets
  contracts validate two-sided evidence and reject unclassified new tests
  test      contracts + all workspace targets + both acceptance demos
  required  static + test; deterministic/offline and suitable for pre-push
  audit     RustSec advisory audit (requires cargo-audit and network/cache)
  full      required + audit
  deep      release suite with elevated property/model case counts
  mutation  scoped evaluator/promotion mutation run (requires cargo-mutants)
  all       full + deep + mutation
EOF
}

case "${1:-required}" in
    static)
        run_static
        ;;
    contracts)
        run_contracts
        ;;
    test)
        run_test
        ;;
    required)
        run_static
        run_test
        ;;
    audit)
        run_audit
        ;;
    full)
        run_static
        run_test
        run_audit
        ;;
    deep)
        run_deep
        ;;
    mutation)
        run_mutation
        ;;
    all)
        run_static
        run_test
        run_audit
        run_deep
        run_mutation
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 64
        ;;
esac
